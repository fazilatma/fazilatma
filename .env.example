# مسیر فایل JSON روی Disk/Volume پایدار PaaS
OPTIBID_DATA_FILE=/path/to/persistent-disk/optibid-data.json

# مسیر پوشه رمزنگاری‌شده مدارک احراز هویت روی همان Disk پایدار
OPTIBID_UPLOAD_DIR=/path/to/persistent-disk/kyc-uploads

# یک رشته تصادفی طولانی و محرمانه؛ بعد از ذخیره اطلاعات بانکی یا مدارک تغییر ندهید
OPTIBID_BANK_ENCRYPTION_KEY=replace-with-a-long-random-secret

# حالت بازیابی رمز: در حالت demo لینک روی صفحه نمایش داده می‌شود
# برای محیط واقعی پس از اتصال سرویس ایمیل مقدار را email قرار دهید
OPTIBID_PASSWORD_RESET_MODE=demo

# اختیاری: دامنه خارجی سامانه
NEXT_PUBLIC_EXTERNAL_BASE_URL=https://optibid.arena.site
